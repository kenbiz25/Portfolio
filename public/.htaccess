# Routing for the prerendered React app on Apache/LiteSpeed (cPanel) hosting.
# Fixes 404s on deep links and refreshes (e.g. /portfolio, /portfolio/<id>).
#
#   /                -> index.html
#   /portfolio       -> portfolio.html            (prerendered at build time)
#   /portfolio/<id>  -> portfolio/<id>.html
#   anything else    -> index.html                (React router handles it)

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Real files (assets, images, sitemap, llms.txt, PHP handlers) are served as-is
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Clean URL -> prerendered page, with or without a trailing slash
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # Everything else goes to the React app
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType text/plain .txt
  AddCharset utf-8 .txt .html
</IfModule>

<IfModule mod_headers.c>
  # Pages: always revalidate so new deploys show up immediately
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # (long-lived caching for hashed bundles lives in assets/.htaccess)
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
